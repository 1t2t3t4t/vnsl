scene MainScene

char Boss

"This is it..."

[textInput key: "MC" label: "What is your name?"]

[UnHandleActionTest]

"Since when that I left this town?.."

char MrMan

"Why don't you just move around? \"{{MC}}\"?"

[bg path: "res://icon.svg"]

jump tryRemember

if |myPoint == 2|:
    "Alright.. no point in remembering all these things.
    It's time to move on."

jump notExistLabel

choice:
    "Go home":
        "Let's go!!"
    "I will stay here a bit longer":
        "Don't need to go now I guess"

goto SubScene

label tryRemember:
    if |myPoint == 2|:
        "2 years I assume?"
    else:
        "Can't remember..."
