[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
windows.debug.x86_64 =   "res://addons/godot_vnsl/bin/debug/vnsl_godot.dll"
windows.release.x86_64 = "res://addons/godot_vnsl/bin/release/vnsl_godot.dll"
macos.debug = "res://addons/godot_vnsl/bin/debug/libvnsl_godot.dylib"
macos.release = "res://addons/godot_vnsl/bin/release/libvnsl_godot.dylib"
