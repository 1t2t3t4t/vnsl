// Static tasks configuration.
//
// Example:
[
  {
    "label": "Test All",
    "command": "cargo test --all",
    "reveal_target": "center"
  },
  {
    "label": "Build All",
    "command": "cargo build --all",
    "hide": "on_success"
  },
  {
    "label": "Build Godot (Win)",
    "command": "./buildGodot.bat",
    "hide": "on_success"
  },
  {
    "label": "Build Godot (Shell)",
    "command": "./buildGodot.sh",
    "hide": "on_success"
  }
]
