scene ConditionTest

global a 20
global b 10

"Start"

if |global.a == 20|:
    "A"
    "B"
    global b 30
    if |global.b == 10|:
        "Wrong"
    elif |global.b == 30|:
        "C"
        if |global.a == 100|:
            "Wrong"
        elif |global.a == 300|:
            "Wrong"
        else:
            "D"
else:
    "Else Wrong"

"End"
