script = { SOI ~ scene ~ (stmt | label_scope)* ~ EOI }

WHITESPACE  = _{ NEWLINE }
COMMENT     = _{ "#" ~ (!"\n" ~ ANY)* }
spacer      = _{ " "* }
indentation = _{ "\t" | " "{4} }

// Core
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Data Types
char      =  {
    !("\"" | "\\" | NEWLINE) ~ ANY
  | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "t")
  | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}
line      = @{ char* }
lines     = _{ line ~ (NEWLINE ~ PEEK_ALL ~ line)* }
string    = ${ "\"" ~ lines ~ "\"" }
number    = ${ (NUMBER | ".")+ }
bool      =  { "true" | "false" }
data_type =  { string | number | bool }

// Expressions
lua_lang      = @{ (ASCII_ALPHANUMERIC | "\"" | "_" | " " | "+" | "-" | "*" | "/" | ">" | "<" | "=" | "(" | ")" | "." | ",")+ }
lua_eval_expr = _{ "|" ~ spacer ~ lua_lang ~ spacer ~ "|" }
lua_script    = @{ lua_lang ~ (NEWLINE ~ PEEK_ALL ~ lua_lang)* }
lua_expr      =  { "||" ~ spacer ~ lua_script ~ spacer ~ "||" }

// Commands
dialogue      = { string }
action        = { "[" ~ identifier ~ args ~ "]" }
args          = { (spacer ~ action_arg)* }
action_arg    = { (identifier ~ ":" ~ spacer)? ~ data_type }
jump          = { "jump" ~ spacer ~ identifier }
global        = { "global" ~ spacer ~ identifier ~ spacer ~ data_type }
set_character = { ("character" | "char") ~ spacer ~ identifier }
goto          = { "goto" ~ spacer ~ identifier }
return        = { "return" }
pass          = { "pass" }
command       = { dialogue | set_character | action | global | jump | goto | return | pass }

choice_condition =  {
    spacer ~ "if" ~ spacer ~ condition_block ~ spacer
}
choice           =  {
    string ~ choice_condition? ~ block
}
choices_block    = _{
    ":" ~ PEEK_ALL ~ PUSH(indentation) ~ choice ~ (PEEK_ALL ~ choice)* ~ DROP
}
choices          =  {
    ("choices" | "choice") ~ choices_block
}

condition       =  {
    if_block ~ (PEEK_ALL ~ elif_block)* ~ (PEEK_ALL ~ else_block)?
}
if_block        =  {
    "if" ~ spacer ~ condition_block ~ spacer ~ block
}
elif_block      =  {
    "elif" ~ spacer ~ condition_block ~ spacer ~ block
}
else_block      =  {
    "else" ~ spacer ~ block
}
condition_block = _{
    lua_eval_expr
}

// Flow
stmt        =  { command | choices | condition | lua_expr }
block_stmt  = _{ stmt }
block       =  {
    ":" ~ PEEK_ALL ~ PUSH(indentation) ~ block_stmt ~ (PEEK_ALL ~ block_stmt)* ~ DROP
}
label_scope =  {
    "label" ~ spacer ~ identifier ~ block
}
scene       =  { "scene" ~ spacer ~ identifier }
