WHITESPACE = _{ NEWLINE }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }

// Data Types
char = {
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}
inner = @{ char* }
string = { "\"" ~ inner ~ "\"" }
number = @{ (NUMBER | ".")+ }
bool = @{ "true" | "false" }

// Commands
dialogue = { string }
action_arg = { string | number | bool }
action = ${ "[" ~ identifier ~ (" "+ ~ action_arg)* ~ "]" }

command = { dialogue | action }

// Core
identifier = @{ (ASCII_ALPHA | NUMBER)+ }
stmt = { command }

scene = { "scene" }

indentation = _{ "\t" | " "{4} }
block = {
	PEEK_ALL ~ PUSH(indentation) ~ stmt ~
    (PEEK_ALL ~ stmt)* ~
    DROP
}
label_scope = {
	"'" ~ identifier ~ ":"
}

script = { SOI ~ stmt+ ~ label_scope* ~ EOI }