script = { SOI ~ scene ~ main_statement ~ labels ~ EOI }

WHITESPACE  = _{ NEWLINE }
COMMENT     = _{ "#" ~ (!"\n" ~ ANY)* }
spacer      = _{ " "* }
indentation = _{ "\t" | " "{4} }

// Core
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Data Types
char      =  {
    !("\"" | "\\" | NEWLINE) ~ ANY
  | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "t")
  | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}
line      = @{ char* }
lines     = _{ line ~ (NEWLINE ~ PEEK_ALL ~ line)* }
string    = ${ "\"" ~ lines ~ "\"" }
number    = ${ (NUMBER | ".")+ }
bool      =  { "true" | "false" }
data_type =  { string | number | bool }

// Expressions
eval_expr     = @{ (ASCII_ALPHANUMERIC | "\"" | "_" | " " | "+" | "-" | "*" | "/" | ">" | "<" | "=" | "(" | ")" | ".")+ }
lua_eval_expr = _{ "|" ~ spacer ~ eval_expr ~ spacer ~ "|" }

// Commands
dialogue      = { string }
action        = { "[" ~ identifier ~ args ~ "]" }
args          = { (spacer ~ action_arg)* }
action_arg    = { (identifier ~ ":" ~ spacer)? ~ data_type }
jump          = { "jump" ~ spacer ~ identifier }
global        = { "global" ~ spacer ~ identifier ~ spacer ~ data_type }
set_character = { ("character" | "char") ~ spacer ~ identifier }
command       = { dialogue | set_character | action | global | jump }

choice        =  {
    string ~ block
}
choices_block = _{
    ":" ~ PEEK_ALL ~ PUSH(indentation) ~ choice ~ (PEEK_ALL ~ choice)* ~ DROP
}
choices       =  {
    "choice" ~ choices_block
}

condition       =  {
    if_block ~ (PEEK_ALL ~ elif_block)* ~ (PEEK_ALL ~ else_block)?
}
if_block        =  {
    "if" ~ spacer ~ condition_block ~ spacer ~ block
}
elif_block      =  {
    "elif" ~ spacer ~ condition_block ~ spacer ~ block
}
else_block      =  {
    "else" ~ spacer ~ block
}
condition_block = _{
    lua_eval_expr
}

// Flow
stmt        =  { command | choices | condition }
block_stmt  = _{ !(global) ~ stmt }
block       =  {
    ":" ~ PEEK_ALL ~ PUSH(indentation) ~ block_stmt ~ (PEEK_ALL ~ block_stmt)* ~ DROP
}
label_scope =  {
    "label" ~ spacer ~ identifier ~ block
}
scene       =  { "scene" ~ spacer ~ identifier }

main_statement =  { stmt* }
labels         = _{ label_scope* }
